{
    "$comment": "Gemeinsame FreqAI-Bedingungen für Bot A und Bot B (identisch für beide). Bot-spezifisches steht in config/project.json -> bots.",
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 90,
        "backtest_period_days": 30,
        "live_retrain_hours": 0,
        "activate_tensorboard": false,
        "write_metrics_to_disk": false,
        "feature_parameters": {
            "label_period_candles": 12,
            "DI_threshold": 0,
            "weight_factor": 0,
            "use_SVM_to_remove_outliers": false,
            "principal_component_analysis": false
        },
        "data_split_parameters": {"test_size": 0.15, "shuffle": false},
        "kitb": {
            "label_threshold": 0.006,
            "entry_proba": 0.6,
            "exit_proba": 0.45,
            "min_history_days_before_backtest": 300
        }
    }
}
