{
    "$comment": "Projektweite Phase-1-Einstellungen (nicht Freqtrade). Kosten je Order-Seite als Anteil (0.001 = 0,1 %).",
    "allowed_exchanges": [
        "binance",
        "okx",
        "kraken"
    ],
    "allowed_pairs": [
        "BTC/USDT",
        "ETH/USDT"
    ],
    "timeframes": [
        "1h",
        "1d"
    ],
    "costs": {
        "fee_per_side": 0.001,
        "slippage_per_side": 0.0005,
        "half_spread_per_side": 0.0002
    },
    "validation": {
        "max_abs_log_return": {
            "1m": 0.15,
            "5m": 0.2,
            "15m": 0.25,
            "1h": 0.3,
            "4h": 0.4,
            "1d": 0.6
        },
        "max_staleness_candles": 3
    },
    "network": {
        "retries": 4,
        "backoff_base_seconds": 2.0,
        "timeout_ms": 15000
    },
    "evaluation": {
        "split_fractions": {
            "train": 0.6,
            "validation": 0.2,
            "test": 0.2
        },
        "window_days": 90,
        "step_days": 90,
        "regime": {
            "trend_sma_days": 50,
            "slope_lookback_days": 10,
            "vol_days": 30
        },
        "strategies": [
            "BaselineEmaCross",
            "TrendEmaAdx",
            "MomentumMacdRsi",
            "MeanReversionBollinger",
            "BreakoutDonchian",
            "VolatilitySqueeze"
        ],
        "ml_reference_strategies": [
            "BaselineEmaCross"
        ],
        "daily_strategies": [
            "DailyTrendSma",
            "DailyMomentum"
        ]
    },
    "bots": {
        "bot_a": {
            "description": "Effizient: logistische Regression, wenige Features, nur 1h",
            "strategy": "BotAEfficient",
            "freqaimodel": "KitbLogisticRegression",
            "feature_parameters": {
                "include_timeframes": [
                    "1h"
                ],
                "include_corr_pairlist": [],
                "indicator_periods_candles": [
                    14
                ],
                "include_shifted_candles": 0
            },
            "model_training_parameters": {
                "C": 0.5,
                "max_iter": 1000,
                "class_weight": "balanced"
            }
        },
        "bot_b": {
            "description": "Erweitert: LightGBM, mehr Features, 1h+1d, BTC/ETH-Korrelation, verschobene Kerzen",
            "strategy": "BotBExtended",
            "freqaimodel": "KitbLightGBMClassifier",
            "feature_parameters": {
                "include_timeframes": [
                    "1h",
                    "1d"
                ],
                "include_corr_pairlist": [
                    "BTC/USDT",
                    "ETH/USDT"
                ],
                "indicator_periods_candles": [
                    10,
                    20,
                    50
                ],
                "include_shifted_candles": 2
            },
            "model_training_parameters": {
                "n_estimators": 300,
                "learning_rate": 0.05,
                "num_leaves": 31,
                "random_state": 42,
                "n_jobs": 4,
                "verbose": -1,
                "class_weight": "balanced"
            }
        }
    },
    "agents": {
        "enabled": false,
        "$comment": "Agenten werden nur eingesetzt, wenn 'kitb agents-evaluate' den Nutzen belegt UND ein Mensch enabled=true setzt.",
        "pairs_to_evaluate": {
            "AgentGatedBaseline": "BaselineEmaCross",
            "AgentGatedBreakout": "BreakoutDonchian"
        },
        "benefit_criteria": {
            "min_profit_improvement": 0.0,
            "max_drawdown_not_worse": true,
            "min_share_windows_better": 0.6,
            "min_trades_kept_ratio": 0.3,
            "require_train_not_worse": true
        }
    },
    "paper_strategies": {
        "trend_d1": {
            "strategy": "DailyTrendSma",
            "description": "Regel-Strategie: Tagesschluss über SMA 200 (bestand Vorperiode 2019–2021 und Test-Abschnitt)"
        }
    }
}
